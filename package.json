{
  "name": "xor",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "webpack --config webpack.config.cjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e:sync": "node test/e2e/sync.mjs",
    "test:e2e:tray": "node test/e2e/tray-check.mjs",
    "test:e2e:screens": "node test/e2e/capture.mjs"
  },
  "build": {
    "appId": "com.example.xor",
    "mac": {
      "target": "dmg",
      "icon": "src/assets/ICON/4.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "src/assets/ICON/4.ico"
    },
    "directories": {
      "output": "release-builds"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMU-2025-Capstone-Design-XOR/Front-End.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SMU-2025-Capstone-Design-XOR/Front-End/issues"
  },
  "homepage": "https://github.com/SMU-2025-Capstone-Design-XOR/Front-End#readme",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.26.3",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.3",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.4",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "chokidar": "^4.0.3",
    "diff": "^7.0.0",
    "electron-store": "^10.0.1",
    "flatted": "^3.3.3",
    "mime-types": "^3.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.4.1"
  }
}
